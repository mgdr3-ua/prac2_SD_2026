
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Identifica el proyecto Java -->
    <groupId>es.ua.watermanagement</groupId>

    <!-- Identifica el modulo WM_WS_E -->
    <artifactId>wm-ws-e</artifactId>

    <!-- Version de nuestro modulo -->
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Compila para Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!-- Cliente Java para comunicarse con Kafka -->
        <dependency>
            <groupId>org.apache.kafka</groupId>

            <!-- Biblioteca para crear productores y consumidores Kafka en Java -->
            <artifactId>kafka-clients</artifactId>

            <version>4.1.1</version>
        </dependency>

    </dependencies>

</project>
